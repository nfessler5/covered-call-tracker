{"swagger":"2.0","info":{"title":"Covered Call Tracker API","description":"API for tracking underlying stock cost basis, option positions, and contract rolls.","version":"0.0.1"},"host":"localhost:8080","consumes":["application/json","application/xml","application/gob"],"produces":["application/json","application/xml","application/gob"],"paths":{"/positions":{"get":{"tags":["positions"],"summary":"list positions","description":"List active or historical covered call positions.","operationId":"positions#list","parameters":[{"name":"status","in":"query","description":"Filter by status (OPEN, EXPIRED, ASSIGNED, ROLLED, CLOSED)","required":false,"type":"string"}],"responses":{"200":{"description":"OK response.","schema":{"type":"array","items":{"$ref":"#/definitions/CoveredCallPosition"}}}},"schemes":["http"]},"post":{"tags":["positions"],"summary":"create positions","description":"Open a new covered call position.","operationId":"positions#create","parameters":[{"name":"CreateRequestBody","in":"body","required":true,"schema":{"$ref":"#/definitions/CoveredCallPosition","required":["underlying_id","strike_price","expiration_date","premium_collected","contracts_count","status"]}}],"responses":{"201":{"description":"Created response.","schema":{"$ref":"#/definitions/CoveredCallPosition","required":["underlying_id","strike_price","expiration_date","premium_collected","contracts_count","status"]}}},"schemes":["http"]}},"/positions/{id}/roll":{"post":{"tags":["positions"],"summary":"roll positions","description":"Close an existing position as ROLLED and create a new open position in one atomic transaction.","operationId":"positions#roll","parameters":[{"name":"id","in":"path","description":"ID of the position being rolled","required":true,"type":"integer","format":"int64"},{"name":"RollRequestBody","in":"body","required":true,"schema":{"$ref":"#/definitions/PositionsRollRequestBody","required":["roll_details"]}}],"responses":{"200":{"description":"OK response.","schema":{"$re